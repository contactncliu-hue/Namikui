.sidebar {
  width: 300px;
  background-color: var(--color-bg-sidebar);
  border-right: 2px solid var(--color-border);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  transition: transform 0.3s ease;
  z-index: 150;
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  transform: translateX(-100%);
}
.sidebarOpen {
  transform: translateX(0);
}

.overlay {
  display: block;
  position: fixed;
  inset: 0;
  background: rgba(15, 17, 26, 0.45);
  z-index: 140;
}

.logo {
  width: 85px;
  height: 85px;
  margin: 24px auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.logoImg {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.user {
  padding: 18px 24px;
  display: flex;
  align-items: center;
  gap: 14px;
  font-weight: 700;
  font-size: var(--font-sm);
  color: #62697b;
  border-bottom: 1px solid var(--color-border-light);
}
.avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background-color: var(--color-primary);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: 800;
  flex-shrink: 0;
}
.userName {
  font-size: var(--font-xs);
  text-transform: uppercase;
}
.userRole {
  font-size: var(--font-xs);
  color: #8c93a6;
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 6px;
  overflow-y: auto;
  padding-bottom: 24px;
  flex-grow: 1;
}
.menu {
  list-style: none;
}
.sectionTitle {
  font-size: var(--font-xs);
  font-weight: 800;
  color: #8c93a6;
  padding: 18px 24px 8px 24px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.item {
  display: flex;
  align-items: center;
  padding: 14px 24px;
  color: #555b6e;
  font-weight: 700;
  font-size: var(--font-xs);
  text-decoration: none;
  gap: 14px;
  cursor: pointer;
  transition: background 0.2s;
}
.item:hover {
  background-color: #f0f2f8;
}
.itemActive {
  background-color: var(--color-primary);
  color: white;
}
.logout {
  color: #d9381e;
}
.logout:hover {
  background-color: #fce8e6;
}
.icon {
  width: 18px;
  text-align: center;
}

.footer {
  padding: 14px 24px;
  border-top: 1px solid var(--color-border-light);
  margin-top: auto;
}

.hamburger {
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 5px;
  margin: 10px 14px;
  align-self: flex-end;
}
.hamburgerLine {
  width: 26px;
  height: 3px;
  background-color: var(--color-primary);
  border-radius: 2px;
}

@media (min-width: 1025px) {
  .overlay {
    display: none;
  }
}
